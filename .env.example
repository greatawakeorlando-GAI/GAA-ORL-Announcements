# Copy this file to .env.local for local development.
# In production (Vercel), set these same names under Project Settings -> Environment Variables.

# --- Upstash Redis (free tier) ---
# Create a database at https://console.upstash.com -> copy the "REST API" values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Push notifications (VAPID keys) ---
# Generate with: npx web-push generate-vapid-keys
# The PUBLIC key is safe to expose to the browser (NEXT_PUBLIC_ prefix).
# The PRIVATE key must stay secret (server-side only).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Admin access ---
# The password church staff enter on /admin to post announcements.
# Pick something you wouldn't mind changing occasionally; there is no username, just this shared password.
ADMIN_PASSWORD=

# --- App branding (optional) ---
NEXT_PUBLIC_CHURCH_NAME=Great Awakening International

# --- "Give" button (optional) ---
# Full web address of your online giving page, e.g. https://give.example.org
NEXT_PUBLIC_GIVE_URL=
